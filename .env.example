SUPABASE_PROJECT_ID="lvqatsptuqaqvmivfjkj"
SUPABASE_URL="https://lvqatsptuqaqvmivfjkj.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
SUPABASE_SECRET_KEY="sb_secret_replace_me"

VITE_SUPABASE_PROJECT_ID="lvqatsptuqaqvmivfjkj"
VITE_SUPABASE_URL="https://lvqatsptuqaqvmivfjkj.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Used only by the Supabase CLI. Do not commit a real value.
SUPABASE_DB_PASSWORD="replace_me"

# Server-only OpenAI configuration for the Exam Generator. Required to generate
# exams; the key is used only on the server and never exposed to the browser.
OPENAI_API_KEY="replace_me"
# Optional. Default model for all Exam Generator roles. Defaults to "gpt-4o-mini"
# when unset. Use a model your account can access that supports JSON-schema
# structured outputs. The per-role overrides below fall back to this value.
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MODEL_GENERATION=""
OPENAI_MODEL_AUDIT=""
OPENAI_MODEL_GRADING=""

# Server-only Gemini configuration for OSCE AI features. OSCE Free-form turns
# require the key and keep deterministic scoring as a fallback.
GEMINI_API_KEY="replace_me"
# Optional. Leave unset to use the app default ("gemini-flash-latest"), or pin a
# served model id from the Gemini API (e.g. "gemini-3.7-flash"). Do NOT set an
# unserved version like "gemini-3.8-flash" -- the API returns 404 and all AI
# generation silently fails.
GEMINI_MODEL="gemini-flash-latest"

# Application-owned auth. Secret used to sign/verify our own session JWTs.
# Generate a strong value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET="replace_me_with_a_long_random_secret"
# Optional. Session lifetime in days (default 30).
AUTH_SESSION_TTL_DAYS="30"
