# Shared server-only Gemini configuration. Annie has deterministic fallbacks;
# OSCE Free-form turns require the key and keep deterministic scoring as fallback.
GEMINI_API_KEY="replace_me"
# Optional. Leave unset to use the app default ("gemini-flash-latest"), or pin a
# served model id from the Gemini API (e.g. "gemini-3.7-flash"). Do NOT set an
# unserved version like "gemini-3.8-flash" -- the API returns 404 and all AI
# generation silently fails.
GEMINI_MODEL="gemini-flash-latest"
